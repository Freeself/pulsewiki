# ── Database ───────────────────────────────────────────────────
DATABASE_PATH=./data.db     # SQLite database file path

# ── OpenAI-compatible API ──────────────────────────────────────
AI_BASE_URL=              # API base URL (e.g. https://api.openai.com/v1, https://dashscope.aliyuncs.com/compatible-mode/v1)
AI_API_KEY=               # API key
AI_MODEL=gpt-4o           # Model name (e.g. gpt-4o, qwen3.6-plus, deepseek-chat)

# ── Default User ───────────────────────────────────────────────
DEFAULT_USER_ID=1         # User ID used when no auth is present
